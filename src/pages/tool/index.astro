---
import { PageHeader, Section } from '@pcl/design-system';
import SiteLayout from '../../components/SiteLayout.astro';
import { u } from '../../lib/url';
---
<SiteLayout
  title="Interactive Tool — StaMPS Data Framework"
  description="Interactive preliminary tool: the StaMPS item library with expert consensus verdicts and reporting guideline mapping, filterable by verdict, timepoint, and guideline."
  path="/tool/"
  banner="Preliminary tool — reflects consensus after Round 2 of 4. Items without a Core verdict remain to be evaluated in Rounds 3–4."
  bannerFeedbackLink={false}
>
  <PageHeader wide eyebrow="Interactive tool" title="StaMPS Preliminary Variables" lead="StaMPS Data Framework — Standardizing Measures in Psychedelic Science. Item library with expert consensus and reporting guideline mapping." />

  <Section wide tight>
    <div class="card tool-controls" id="tool-controls">
      <fieldset>
        <legend>Tentative Core Verdict</legend>
        <div class="chip-grid">
          <label class="filter-chip core" id="lbl-core"><input type="checkbox" id="chk-core"> For All Purposes</label>
          <label class="filter-chip econ" id="lbl-econ"><input type="checkbox" id="chk-econ"> For Economic Purposes</label>
          <label class="filter-chip group" id="lbl-group"><input type="checkbox" id="chk-group"> For Group Interventions</label>
          <label class="filter-chip notcore" id="lbl-notcore"><input type="checkbox" id="chk-notcore"> Not Core</label>
        </div>
      </fieldset>

      <fieldset>
        <legend>Timepoint</legend>
        <div class="chip-grid" id="timepoint-row"></div>
      </fieldset>

      <div class="tool-row">
        <div class="control-group">
          <label class="group-title" for="sel-guideline">Reporting Guideline</label>
          <select id="sel-guideline">
            <option value="">All guidelines</option>
          </select>
        </div>
        <div class="control-group">
          <label class="group-title" for="search-box">Search item</label>
          <input type="search" id="search-box" placeholder="Filter by item text..." autocomplete="off">
        </div>
        <div class="control-group">
          <span class="group-title" id="tree-title">Tree</span>
          <div class="cluster" role="group" aria-labelledby="tree-title">
            <button type="button" class="btn btn--secondary btn--small" id="expand-all-btn">Expand all</button>
            <button type="button" class="btn btn--secondary btn--small" id="collapse-all-btn">Collapse all</button>
          </div>
        </div>
        <div class="control-group">
          <span class="group-title visually-hidden">Reset</span>
          <button type="button" class="btn btn--quiet btn--small" id="reset-btn">Reset filters</button>
        </div>
      </div>
    </div>

    <div class="tool-meta">
      <span id="result-count" role="status" aria-live="polite"></span>
      <span id="filter-summary"></span>
    </div>

    <div class="table-wrap tool-table-wrap">
      <table class="tool-table">
        <thead>
          <tr>
            <th scope="col" class="sortable" data-key="item" aria-sort="none"><button type="button" class="sort-btn">Item <span class="arrow" aria-hidden="true"></span></button></th>
            <th scope="col" class="sortable" data-key="verdict" aria-sort="none"><button type="button" class="sort-btn">Verdict <span class="arrow" aria-hidden="true"></span></button></th>
            <th scope="col" class="sortable" data-key="guidelines" aria-sort="none"><button type="button" class="sort-btn">Reporting Guidelines <span class="arrow" aria-hidden="true"></span></button></th>
          </tr>
        </thead>
        <tbody id="table-body"></tbody>
      </table>
      <p class="empty-state" id="empty-state" hidden>No items match the current filters.</p>
    </div>

    <div class="callout tool-note">
      <strong>This tool is a work in progress — help us improve it.</strong>
      Verdicts reflect consensus after two of four Delphi rounds: items marked "—" have not been rejected — most remain to be evaluated in Rounds 3–4, when Core and Supplementary classifications are finalized. If an item seems missing, misplaced, or mislabeled — or you have suggestions for the tool itself — please
      <a href={u('/feedback/')}>share your feedback</a>.
    </div>
  </Section>

  <script>
    import '../../scripts/tool.js';
  </script>
</SiteLayout>

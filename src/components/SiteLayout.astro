---
/**
 * <SiteLayout> — the design-system <Layout> plus what every StaMPS page shares:
 * base-aware favicon, the ResearchProject schema, the status banner and the
 * FRQS / PMHA partner logos in the footer.
 */
import { Layout } from '@pcl/design-system';
import { site, navFor, researchProjectSchema } from '../site.config';
import { u } from '../lib/url';
import StatusBanner from './StatusBanner.astro';
import PartnerLogos from './PartnerLogos.astro';
import '../styles/site.css';

export interface Props { title: string; description: string; path: string; banner?: string; bannerFeedbackLink?: boolean }
const { title, description, path, banner, bannerFeedbackLink = true } = Astro.props;
---
<Layout site={site} page={{ title, description, path, schema: researchProjectSchema }} nav={navFor(path)}>
  <link slot="head" rel="icon" href={u('/favicon.svg')} type="image/svg+xml" />
  <link slot="head" rel="apple-touch-icon" href={u('/apple-touch-icon.png')} />
  <main id="main">
    <StatusBanner text={banner} feedbackLink={bannerFeedbackLink} />
    <slot />
  </main>
  <PartnerLogos slot="footer-logos" />
  <p slot="footer-meta">Supported by the <a href="https://www.pmhaa.org/" target="_blank" rel="noopener noreferrer">Psychedelic Mental Health Access Alliance</a>, FRQS, and the Lady Davis Institute.</p>
</Layout>
